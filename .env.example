# App Base URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Panel Secret (required in production; dev defaults to civciv-admin-dev)
ADMIN_SECRET=change-this-to-a-long-random-secret

# Vercel Cron Secret (protects /api/cron/cleanup-photos)
CRON_SECRET=change-this-cron-secret

# -----------------------------------------------------------------------------
# Supabase (leave blank locally to use automatic Dev/Mock Mode)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Resend Transactional Email (leave blank locally to use Dev Email Outbox)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=boyorgirl.party <noreply@boyorgirl.party>

# -----------------------------------------------------------------------------
# Lemon Squeezy Merchant of Record (leave blank locally to use Mock Checkout)
# -----------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_MINI=
LEMONSQUEEZY_VARIANT_PARTY=
LEMONSQUEEZY_VARIANT_MEGA=
